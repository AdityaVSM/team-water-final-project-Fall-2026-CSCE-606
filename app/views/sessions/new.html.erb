<h1>Log in to Roommate OS</h1>

<% if flash[:alert] %>
  <p role="alert"><%= flash[:alert] %></p>
<% end %>

<%= form_with url: login_path, scope: nil do |form| %>
  <div>
    <%= form.label :email %>
    <%= form.email_field :email, required: true %>
  </div>

  <div>
    <%= form.label :password %>
    <%= form.password_field :password, required: true %>
  </div>

  <%= form.submit "Log In" %>
<% end %>

<p>Don't have an account? <%= link_to "Sign up", signup_path %></p>